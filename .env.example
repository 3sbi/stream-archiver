TWITCH_CHANNEL=xqc
KICK_CHANNEL=xqc
WTV_CHANNEL=xqc
PLATFORM=twitch

# optional: enables Helix API (live-status polling + stream info).
# When unset, stream info is fetched from Twitch's open GraphQL endpoint instead.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# config variables for aiogram/telegram-bot-api
# https://github.com/aiogram/telegram-bot-api#configuration
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOCAL=true

TELEGRAM_API_URL=http://telegram-bot-api:8081
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# TELEGRAM_SECOND_CHANNEL_ID= # optional: also send files as documents to this channel
TELEGRAM_UPLOAD_MODE=video # or document
GROUP_SEGMENTS=true # collect segments and send as a media group when stream ends or disk space is low

CHECK_INTERVAL=15
IDLE_CHECK_INTERVAL=1 # Helix live-status poll while idle, used only with Twitch + client credentials
METAINFO_CHECK_INTERVAL=120
MIN_FREE_DISK_GB=3
LOG_LEVEL=INFO