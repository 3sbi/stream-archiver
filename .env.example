CHANNEL=xqc
PLATFORM=twitch

# config variables for aiogram/telegram-bot-api
# see https://github.com/aiogram/telegram-bot-api#configuration
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOCAL=true

TELEGRAM_API_URL=http://telegram-bot-api:8081
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHANNEL_ID=YOUR_CHANNEL_ID_OR_HANDLE
# TELEGRAM_SECOND_CHANNEL_ID= # optional: also send files as documents to this channel
TELEGRAM_UPLOAD_MODE=video # or document
GROUP_SEGMENTS=true # collect segments and send as a media group when stream ends or disk is low
# TELEGRAM_WATERMARK_TEXT= # channel_name or nothing if watermark is not needed

CHECK_INTERVAL=15
METAINFO_CHECK_INTERVAL=120
MIN_FREE_DISK_GB=2

# Segment duration is computed from the stream bitrate measured at stream start
# so each segment is as large as possible without exceeding the Telegram 2 GiB limit.
# These are the knobs for that logic (defaults shown):
MAX_SEGMENT_SIZE_GB=1.9 # hard ceiling per segment
SEGMENT_SIZE_MARGIN=0.95 # safety headroom for keyframe overshoot
BITRATE_PROBE_SECONDS=10 # how long the start of the stream is buffered to measure bitrate
MIN_SEGMENT_TIME=60 # floor for the computed segment duration
# SEGMENT_TIME=2630 # fallback duration used if bitrate cannot be measured
LOG_LEVEL=INFO